# Sao chép thành .env rồi sửa giá trị. KHÔNG commit file .env.

# Backend
KNN_DATABASE_URL=sqlite:///./knn.db
KNN_JWT_SECRET=change-me-to-a-long-random-string
KNN_JWT_EXPIRE_MINUTES=120
KNN_CORS_ORIGINS=["http://localhost:5173"]
KNN_ARTIFACTS_DIR=artifacts/models

# Tài khoản mẫu cho 3 vai trò, dùng bởi scripts/seed_db.py (giai đoạn 5).
# Chỉ dùng cho môi trường demo cục bộ.
KNN_SEED_ADMIN_USERNAME=admin
KNN_SEED_ADMIN_PASSWORD=
KNN_SEED_DS_USERNAME=datasci
KNN_SEED_DS_PASSWORD=
KNN_SEED_USER_USERNAME=demo
KNN_SEED_USER_PASSWORD=
